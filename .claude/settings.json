{
  "permissions": {
    "allow": [
      "Read", "Glob", "Grep",
      "Edit", "Write",
      "Bash(npm:*)", "Bash(pnpm:*)", "Bash(git:*)",
      "Bash(mkdir:*)", "Bash(ls:*)", "Bash(cat:*)",
      "Bash(supabase:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Read(./.env)",
      "Read(./**/*.pem)",
      "Bash(curl:*)"
    ]
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  }
}
